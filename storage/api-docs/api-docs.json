        "/api/departments/{id}/transfer-employees": {
            "post": {
                "tags": [
                    "Transferencia"
                ],
                "summary": "Transferir colaboradores",
                "description": "Transfere todos os colaboradores ativos do departamento de origem para o departamento de destino com execucao atomica e rollback em caso de falha.",
                "operationId": "8108032ceed89d9b06721002eab92cdd",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID do departamento de origem",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "target_department_id"
                                ],
                                "properties": {
                                    "target_department_id": {
                                        "type": "integer",
                                        "example": 2
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Transferencia concluida com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Colaboradores transferidos com sucesso."
                                        },
                                        "transferred": {
                                            "type": "integer",
                                            "example": 5
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Origem e destino iguais ou erro de validacao"
